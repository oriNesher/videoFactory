# Video Factory — backend configuration.
#
# Copy this file to `.env` in the repository root and fill in what you need.
# `.env` is git-ignored: real keys must never be committed.
#
#   Copy-Item .env.example .env
#
# These values are read by the backend process only. Nothing here reaches the
# frontend bundle, a project file, a plan file or a job record. A variable
# already set in the shell always wins over this file.

# --- AI provider ------------------------------------------------------------

# "mock"      (default) deterministic local rules. No key, no network, and
#             every result is labelled as a demo rather than as AI.
# "anthropic" the real provider. Requires ANTHROPIC_API_KEY below.
VIDEO_FACTORY_LLM_PROVIDER=mock

# Your Anthropic API key. Only used when the provider above is "anthropic".
# Get one at https://console.anthropic.com/ . Leave empty for mock mode.
ANTHROPIC_API_KEY=

# The model used for plan generation. Defaults to claude-opus-5.
VIDEO_FACTORY_LLM_MODEL=claude-opus-5

# How long one provider request may take, in seconds (default 120).
VIDEO_FACTORY_LLM_TIMEOUT=120

# --- zoom planning (Gemini, stage 2B) ----------------------------------------
#
# Recommended: do NOT put the Gemini key in this file. Keep it as a Windows
# user environment variable instead, then start the backend from a new
# terminal:
#   [Environment]::SetEnvironmentVariable("GEMINI_API_KEY", "...", "User")
# Use a key from a dedicated Google AI Studio project that you have checked is
# on the free tier (see README, "Setting up Gemini"). Zoom planning sends
# transcript text and timings to Google; on the free tier Google may use it to
# improve its products and human reviewers may read it. Video and audio never
# leave this computer. There is no fallback to any other provider.
GEMINI_API_KEY=

# "gemini" (default) or "mock" (labelled demo rules; no key, no network).
VIDEO_FACTORY_ZOOM_PROVIDER=gemini

# Check https://ai.google.dev/gemini-api/docs/pricing before changing it:
# not every Gemini model has a free tier.
VIDEO_FACTORY_GEMINI_MODEL=gemini-3.5-flash

# Seconds one Gemini request may take (default 90).
VIDEO_FACTORY_GEMINI_TIMEOUT=90

# --- storage ----------------------------------------------------------------

# Where projects, jobs, plans, intermediates and exports are stored.
# Defaults to <repository>\workspace. Source footage is never stored here.
# VIDEO_FACTORY_WORKSPACE=D:\VideoFactoryWorkspace
